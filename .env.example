# Flobstar News Intelligence Backend — Environment Variables
# Copy this to .env and fill in your real keys
# Never commit .env to git

# ── Application ────────────────────────────────────────────────────────────────
APP_NAME=Flobstar News Intelligence
APP_VERSION=1.0.0
DEBUG=false
ENVIRONMENT=production

# ── Server ─────────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000

# ── Supabase (Database) ────────────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# ── AI Services ────────────────────────────────────────────────────────────────
MISTRAL_API_KEY=your_mistral_api_key          # Primary AI provider
OPENAI_API_KEY=your_openai_api_key            # Optional fallback
ANTHROPIC_API_KEY=your_anthropic_api_key      # Optional fallback

# ── Telegram Newsroom Alerts ───────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id        # Can be a group ID (negative number)

# ── Email (Resend) — optional ──────────────────────────────────────────────────
RESEND_API_KEY=your_resend_api_key

# ── Polling configuration ──────────────────────────────────────────────────────
RSS_POLLING_INTERVAL_MINUTES=15               # How often to check all RSS feeds
MAX_CONCURRENT_SOURCE_CHECKS=10

# ── Frontend URL (used in Telegram review links) ───────────────────────────────
FRONTEND_URL=https://your-domain.vercel.app
